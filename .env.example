# Server Configuration
PORT=3000

# "development" keeps Vite HMR middleware, "production" serves dist/ (built by
# `npm run build`). Render sets this to production for you.
NODE_ENV=development

# ===========================================================================
# Supabase  (Dashboard > Project Settings > API Keys)
# ===========================================================================
# All three are required. The server never crashes when they are missing - it
# answers API calls with a clear "Supabase is not configured" message instead.
SUPABASE_URL=https://your-project-ref.supabase.co

# "anon" / "publishable" key. Safe to ship to a browser; used here only to
# verify incoming access tokens.
SUPABASE_ANON_KEY=your-anon-key

# "service_role" / "secret" key. SERVER ONLY - it bypasses Row Level Security.
# Never commit this and never expose it to public/ or src/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================================================
# First admin user (used only by: npm run seed)
# Leave these empty and pass --email / --password on the command line instead.
# ===========================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vite dev server (optional)
# Set to true only in AI Studio sandboxes to disable HMR + file watching.
DISABLE_HMR=false
