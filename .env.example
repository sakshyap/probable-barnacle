# Database connection string (PostgreSQL)
DATABASE_URL=

# Server & frontend port (required; api-server and Vite both read PORT)
PORT=5000

# Base URL path for the frontend
BASE_PATH=/

# Runtime mode: development | production
NODE_ENV=development

# Pino log level (debug | info | warn | error); defaults to info
LOG_LEVEL=info

# Replit deployment ID; only used to enable Replit dev plugins
REPL_ID=

# Build flag; true during Replit post-build
CI=false

# Groq API key for AI features
GROQ_API_KEY=