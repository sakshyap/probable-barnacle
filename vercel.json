{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/login.html" },
    { "source": "/admin/login", "destination": "/login.html" },
    { "source": "/admin/dashboard", "destination": "/dashboard.html" },
    { "source": "/portfolio-admin", "destination": "/portfolio-login.html" },
    { "source": "/portfolio-admin/login", "destination": "/portfolio-login.html" },
    { "source": "/portfolio-admin/dashboard", "destination": "/portfolio-dashboard.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/((?!api|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ]
}
